    {
      "parameters": {
        "jsCode": "// n8n Code node (Mode: Run Once for All Items)\n// Sums Total Order Items (+ B2B) and Ordered Product Sales (+ B2B)\n// Outputs ONE row per file: Month, Total_Orders, Total_Revenue, Source_File\n\nfunction toNumber(val) {\n  if (val === null || val === undefined) return 0;\n  const s = String(val).trim();\n  if (!s) return 0;\n  const n = Number(s.replace(/[$,]/g, \"\"));\n  return Number.isFinite(n) ? n : 0;\n}\n\n// 1) Get the CURRENT file name for THIS loop execution\nlet fileName = \"\";\ntry {\n  const dlItem = $items(\"Download file\", 0, $runIndex)[0]; // <-- key change\n  fileName =\n    dlItem?.binary?.data?.fileName ||\n    dlItem?.json?.name ||\n    dlItem?.json?.fileName ||\n    \"\";\n} catch (e) {\n  fileName = \"\";\n}\n\n// 2) Build Month from filename like BR-12-1-25.csv\nconst months = [\"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"];\nlet monthValue = \"\";\n\nconst m = String(fileName).match(/-(\\d{1,2})-(\\d{1,2})-(\\d{2})/); // -(MM)-(DD)-(YY)\nif (m) {\n  const mm = Number(m[1]);\n  const yy = m[3];\n  if (mm >= 1 && mm <= 12) {\n    monthValue = `1-${months[mm - 1]}-20${yy}`;\n  }\n}\n\n// 3) Sum totals across ALL extracted rows (items = rows from Extract from File)\nlet totalOrders = 0;\nlet totalRevenue = 0;\n\nfor (const row of items) {\n  const orders = toNumber(row.json[\"Total Order Items\"]);\n  const ordersB2B = toNumber(row.json[\"Total Order Items - B2B\"]);\n\n  const sales = toNumber(row.json[\"Ordered Product Sales\"]);\n  const salesB2B = toNumber(row.json[\"Ordered Product Sales - B2B\"]);\n\n  totalOrders += orders + ordersB2B;\n  totalRevenue += sales + salesB2B;\n}\n\n// 4) Return ONE item (one row for Google Sheets)\nreturn [\n  {\n    json: {\n      Month: monthValue,\n      Total_Orders: totalOrders,\n      Total_Revenue: Number(totalRevenue.toFixed(2)),\n      Source_File: fileName,\n    },\n  },\n];\n"
      },
